# Copy this file to .env and adjust the values if needed.
# Development-only credentials, matching docker-compose.yml.

# SQLAlchemy URL. "postgresql+psycopg" selects the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/scheduling

# Log every SQL statement (true / false).
SQL_ECHO=false

SECRET_KEY=change-me-generate-with-secrets-token-urlsafe.
ACCESS_TOKEN_EXPIRE_MINUTES=10
